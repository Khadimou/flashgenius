# ─── FlashGenius ───────────────────────────────────

# Vercel KV (landing page waitlist storage)
KV_REST_API_URL=your_upstash_rest_url
KV_REST_API_TOKEN=your_upstash_rest_token

# Dashboard waitlist (Basic Auth)
DASHBOARD_PASSWORD=flashgenius

# ─── App ───────────────────────────────────────────

# Neon PostgreSQL (flashgenius-app database)
# Create at neon.tech → New Project → copy the connection strings
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/flashgenius?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/flashgenius?sslmode=require

# NextAuth
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Resend (email magic link) — only needed in production
# Get at resend.com (free tier: 3 000 emails/mois)
RESEND_API_KEY=re_...
EMAIL_FROM=FlashGenius <noreply@yourdomain.com>
